{
  "kind": "collectionType",
  "collectionName": "content_pages",
  "info": {
    "singularName": "content-page",
    "pluralName": "content-pages",
    "displayName": "Content Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "pageType": {
      "type": "enumeration",
      "enum": [
        "home",
        "contact",
        "events",
        "sales",
        "research",
        "node",
        "options",
        "ventures",
        "marketplace",
        "tailored-products",
        "service",
        "industry",
        "strategy",
        "governance",
        "forwards",
        "spots"
      ],
      "required": true
    },
    "variant": {
      "type": "string"
    },
    "navLabel": {
      "type": "string"
    },
    "menuGroup": {
      "type": "string"
    },
    "parentSlug": {
      "type": "string"
    },
    "menuOrder": {
      "type": "integer",
      "default": 0
    },
    "showInNavigation": {
      "type": "boolean",
      "default": true
    },
    "introTitle": {
      "type": "string"
    },
    "introDescription": {
      "type": "text"
    },
    "summary": {
      "type": "text"
    },
    "paragraphs": {
      "type": "json"
    },
    "closing": {
      "type": "text"
    },
    "customData": {
      "type": "json"
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.hero"
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "insightItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.insight-item"
    },
    "accordionItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.accordion-item"
    },
    "detailSections": {
      "type": "component",
      "repeatable": true,
      "component": "shared.content-section"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "partnerLogos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
